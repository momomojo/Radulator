{
  "name": "radcalc-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/update-about.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "generate:mesa-reference": "node scripts/generate-mesa-cac-reference.mjs --output src/data/mesaCacReference.js --audit-output docs/evidence/mesa-cac-reference-audit.json --concurrency 1",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:smoke": "npm run build && playwright test tests/e2e/smoke",
    "test:calculator": "playwright test tests/e2e/calculators",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:compute": "node scripts/generate-mesa-cac-reference.test.mjs && node --import ./scripts/register-jsx-loader.mjs scripts/run-compute-tests.mjs",
    "test:search-verification": "node tests/search-verification-meta.test.mjs && node tests/ping-search-indexes.test.mjs",
    "test:invariants": "node scripts/check-radulator-invariants.test.mjs",
    "test:independent-review-gate": "node scripts/independent-review-gate.test.mjs",
    "test:release-policy": "node scripts/release-policy.test.mjs",
    "test:auto-merge": "node scripts/auto-merge.test.mjs",
    "test:release-workflow-permissions": "node scripts/release-workflow-permissions.test.mjs",
    "test:post-deploy-smoke": "node scripts/post-deploy-smoke.test.mjs",
    "test:release-marker": "node scripts/write-release-marker.test.mjs",
    "test:authorize-deployment": "node scripts/authorize-deployment.test.mjs",
    "test:reconcile-deployment": "node scripts/reconcile-deployment.test.mjs",
    "test:rollback-deployment": "node scripts/select-rollback-deployment.test.mjs",
    "test:hermes-judge-candidates": "node ops/hermes/radulator/judge-candidates.test.mjs",
    "test:hermes-judge-attest": "node ops/hermes/radulator/judge-attest.test.mjs",
    "test:hermes-lifecycle": "python3 -m unittest discover -s ops/hermes/radulator/tests -p 'test_lifecycle_controller.py'",
    "test:hermes-learning": "python3 -m unittest discover -s ops/hermes/radulator/tests -p 'test_*learning*.py'",
    "test:hermes-feedback-intake": "python3 -m unittest discover -s ops/hermes/radulator/tests -p 'test_formspree_feedback_intake.py'",
    "test:hermes-install": "python3 -m unittest discover -s ops/hermes/radulator/tests -p 'test_install.py'",
    "test:dev-local": "bash tests/scripts/dev-local-restart.sh",
    "test:decompose-full-suite": "node scripts/full-suite-decomposer.mjs",
    "check:invariants": "node scripts/check-radulator-invariants.mjs",
    "metrics:loops": "node scripts/collect-loop-metrics.mjs",
    "proof:feature": "node scripts/capture-feature-proof.mjs",
    "index:ping": "node scripts/ping-search-indexes.mjs",
    "index:ping:dry-run": "node scripts/ping-search-indexes.mjs --dry-run"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.526.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6",
    "yaml": "^2.9.0"
  }
}
