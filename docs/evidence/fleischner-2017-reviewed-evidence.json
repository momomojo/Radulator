      {
        "id": "fleischner-2017-part-solid-component-escalation",
        "source_url": "https://pubs.rsna.org/doi/10.1148/radiol.2017161659",
        "source_sha256": "f5bb64d6e8d64dfd49f798b586435dc78e4f22d1174e0aee701bb9cd0f8f80b1",
        "source_locator": "Guideline VOR PDF pp9-10/journal pp236-237, Recommendation 4 and Table 1B comment",
        "direct_source_fact": "Persistent part-solid nodules at or above 6 mm are managed by solid-component size and concern: components below 6 mm receive annual surveillance, components at or above 6 mm are highly suspicious, and suspicious morphology, growth, or a component above 8 mm supports PET/CT, biopsy, or resection.",
        "source_text_assertions": [
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:9",
            "locator_text_sha256": "fcc382a97ffe361d0b8e7cb294b1c97e632e0ee2f24c82eeaf2bca1ed3168892",
            "required_snippets": [
              "For solitary part-solid nodules 6 mm or larger with a solid component less than 6 mm in diameter, follow-up is recommended at 3-6 months and then annually for a minimum of 5 years"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:3",
            "locator_text_sha256": "9cafb5c818bd6d44904e7552c7698b5b722513f49d76d6f4c561419269a93a40",
            "required_snippets": [
              "should be considered highly suspicious"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:10",
            "locator_text_sha256": "89ee2523a2aeae1ac3b6b3bd8ea5fa5751aa6551e3f48375bd2bfcbb39d9d473",
            "required_snippets": [
              "For nodules with particularly suspicious morphology (ie, lobulated margins or cystic components), a growing solid component, or a solid component larger than 8 mm, PET/CT, biopsy, or resection are recommended"
            ]
        }
      ],
        "reviewed_synthesis": "Radulator separates baseline persistence, stable surveillance, established quantitative growth, concerning morphology, and a visually new component without mislabeling visual change as measured growth.",
