      {
        "id": "fleischner-2017-applicability",
        "source_url": "https://pubs.rsna.org/doi/10.1148/radiol.2017161659",
        "source_sha256": "f5bb64d6e8d64dfd49f798b586435dc78e4f22d1174e0aee701bb9cd0f8f80b1",
        "source_locator": "Guideline VOR PDF p2/journal p229, Introduction; p3/journal p230, Table 1 note",
        "direct_source_fact": "The guideline applies to incidentally detected CT nodules in adults at least 35 years old and excludes lung-cancer screening, immunosuppression, and known primary cancer.",
        "source_text_assertions": [
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:2",
            "locator_text_sha256": "0c26e959dcbb3b60376d055a619acf3ea3e8618f7906ed948723da707ae586f1",
            "required_snippets": [
              "detected at CT in adult patients who are at least 35 years old"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:3",
            "locator_text_sha256": "9cafb5c818bd6d44904e7552c7698b5b722513f49d76d6f4c561419269a93a40",
            "required_snippets": [
              "These recommendations do not apply to lung cancer screening, patients with immunosuppression, or patients with known primary cancer"
            ]
          }
        ],
        "reviewed_synthesis": "Radulator routes explicitly selected excluded populations away from the Fleischner table without producing a Fleischner schedule.",
        "vector_ids": [
          "screening-routes-away-without-schedule",
          "under-35-routes-away-without-schedule",
          "known-cancer-routes-away-without-schedule",
          "immunocompromised-routes-away-without-schedule"
        ]
      },
      {
        "id": "fleischner-2017-characterization-and-ipln",
        "source_url": "https://pubs.rsna.org/doi/10.1148/radiol.2017161659",
        "source_sha256": "f5bb64d6e8d64dfd49f798b586435dc78e4f22d1174e0aee701bb9cd0f8f80b1",
        "source_locator": "Guideline VOR PDF pp3-5/journal pp230-232, General Recommendations and Figures 1-5; p13/journal p240, Perifissural Nodules",
        "direct_source_fact": "The guideline requires thin-section characterization, recommends no further CT for definitively benign fat or calcification, and recommends no follow-up for nodules with typical intrapulmonary-lymph-node morphology.",
        "source_text_assertions": [
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:3",
            "locator_text_sha256": "9cafb5c818bd6d44904e7552c7698b5b722513f49d76d6f4c561419269a93a40",
            "required_snippets": [
              "Use of thick sections increases volume averaging, which effectively precludes accurate nodule characterization of small nodules"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:4",
            "locator_text_sha256": "04fb20f4adbb35f28f35ae6986502c6a7f241ffd42c27a254915de8ba82ada63",
            "required_snippets": [
              "internal fat and calcification, consistent with a hamartoma. No further CT follow-up is recommended for such findings"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:13",
            "locator_text_sha256": "bbda84c0d3a4815648f03fe3577db07fc5b1612f9704987b911a91476948e396",
            "required_snippets": [
              "morphology consistent with an intrapulmonary lymph node, follow-up CT is not recommended"
            ]
          }
        ],
        "reviewed_synthesis": "Radulator uses adequate characterization, definitive benignity, and typical intrapulmonary-lymph-node morphology to decide whether table routing is appropriate.",
        "vector_ids": [
          "definitively-benign-fat-or-calcification-routes-without-table",
          "typical-intrapulmonary-lymph-node-routes-without-table",
          "thick-section-characterization-fails-closed"
        ]
      },
