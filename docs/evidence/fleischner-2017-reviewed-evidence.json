        "id": "fleischner-2017-selected-subsolid-escalation",
        "source_url": "https://pubs.rsna.org/doi/10.1148/radiol.2017161659",
        "source_sha256": "f5bb64d6e8d64dfd49f798b586435dc78e4f22d1174e0aee701bb9cd0f8f80b1",
        "source_locator": "Guideline VOR PDF pp7-9/journal pp234-236, Recommendations 3-4; especially p9/journal p236",
        "direct_source_fact": "The guideline permits selected follow-up for suspicious subsolid nodules close to 6 mm and states that discrete solid components cannot be reliably defined in such small nodules.",
        "source_text_assertions": [
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:8",
            "locator_text_sha256": "65dcfb613c2a79982ef56f289d50b4f6133bad4e63e017e9d23592c67b353bcb",
            "required_snippets": [
              "including those with pure ground-glass or part-solid types) close to 6 mm in size with suspicious morphology or other risk factors"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:3",
            "locator_text_sha256": "9cafb5c818bd6d44904e7552c7698b5b722513f49d76d6f4c561419269a93a40",
            "required_snippets": [
              "consider follow-up at 2 and 4 years. If solid component(s) or growth develops, consider resection"
            ]
          },
          {
            "artifact_id": "guideline-vor-pdf",
            "locator": "pdf-page:9",
            "locator_text_sha256": "fcc382a97ffe361d0b8e7cb294b1c97e632e0ee2f24c82eeaf2bca1ed3168892",
            "required_snippets": [
              "discrete solid components cannot be reliably defined in such small nodules, and they should be treated similar to the way in which pure ground-glass lesions of equivalent size are treated"
            ]
          }
        ],
        "reviewed_synthesis": "Radulator exposes the selected near-6-mm option without forcing a solid-component measurement that the guideline says may be unreliable.",
