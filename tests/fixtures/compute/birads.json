{
  "calculatorId": "birads",
  "calculatorName": "BI-RADS Assessment Calculator (Legacy 2013)",
  "version": "legacy-fifth-edition-2013-temporary-v1",
  "cases": [
    {
      "id": "missing-finding",
      "inputs": { "modality": "mammography", "study_context": "screening", "additional_needed": "no" },
      "expect": {
        "noError": false,
        "fields": [{ "key": "Error", "equals": "Please select the finding type." }]
      }
    },
    {
      "id": "mammography-incomplete",
      "inputs": { "modality": "mammography", "study_context": "screening", "additional_needed": "yes" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "0 - Incomplete" },
          { "key": "Additional Imaging", "includes": "Additional mammographic views" }
        ]
      }
    },
    {
      "id": "ultrasound-incomplete",
      "inputs": { "modality": "ultrasound", "study_context": "diagnostic", "additional_needed": "yes" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "0 - Incomplete" },
          { "key": "Additional Imaging", "includes": "Mammography if not performed" }
        ]
      }
    },
    {
      "id": "mri-incomplete",
      "inputs": { "modality": "mri", "study_context": "diagnostic", "additional_needed": "yes" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "0 - Incomplete" },
          { "key": "Additional Imaging", "includes": "additional sequences" }
        ]
      }
    },
    {
      "id": "known-biopsy-proven-malignancy",
      "inputs": { "modality": "mri", "study_context": "known_cancer" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "6 - Known Biopsy-Proven Malignancy" },
          { "key": "Management", "includes": "multidisciplinary breast care" },
          { "key": "Management", "includes": "treatment planning" }
        ]
      }
    },
    {
      "id": "negative-screening",
      "inputs": { "modality": "mammography", "study_context": "screening", "additional_needed": "no", "finding_type": "negative" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "1 - Negative" },
          { "key": "Screening Interval", "equals": "Annual (or per guidelines)" }
        ]
      }
    },
    {
      "id": "benign-finding",
      "inputs": { "modality": "ultrasound", "study_context": "diagnostic", "additional_needed": "no", "finding_type": "benign" },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "2 - Benign" },
          { "key": "Malignancy Risk", "equals": "Essentially 0%" },
          { "key": "Management", "equals": "Routine screening according to patient age, risk, symptoms, modality, and local protocol" }
        ]
      }
    },
    {
      "id": "typically-benign-calcifications-are-category-2",
      "inputs": {
        "modality": "mammography", "study_context": "screening", "additional_needed": "no",
        "finding_type": "calcifications", "calc_morphology": "typically_benign"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "2 - Benign" },
          { "key": "Finding Description", "includes": "typically benign calcifications" }
        ]
      }
    },
    {
      "id": "mass-missing-radiologist-suspicion",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "oval", "mass_margin": "circumscribed", "mass_density": "equal"
      },
      "expect": {
        "noError": false,
        "fields": [{ "key": "Error", "includes": "select the overall suspicion level" }]
      }
    },
    {
      "id": "probably-benign-mass",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "oval", "mass_margin": "circumscribed", "mass_density": "equal",
        "suspicion_level": "probably_benign"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "3 - Probably Benign" },
          { "key": "Management", "includes": "6 months" },
          { "key": "Finding Description", "includes": "Mass: oval, circumscribed" }
        ]
      }
    },
    {
      "id": "screening-mammography-probably-benign-needs-diagnostic-workup",
      "inputs": {
        "modality": "mammography", "study_context": "screening", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "oval", "mass_margin": "circumscribed", "mass_density": "equal",
        "suspicion_level": "probably_benign"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "3 - Probably Benign" },
          { "key": "Decision Check", "includes": "screening mammography" },
          { "key": "Decision Check", "includes": "diagnostic workup" }
        ]
      }
    },
    {
      "id": "low-suspicion-mass",
      "inputs": {
        "modality": "ultrasound", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "oval", "mass_margin": "obscured", "suspicion_level": "low_suspicion"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "4A - Low Suspicion for Malignancy" },
          { "key": "Malignancy Likelihood", "equals": "2-10%" }
        ]
      }
    },
    {
      "id": "moderate-suspicion-calcifications",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "calcifications", "calc_morphology": "coarse_heterogeneous", "calc_distribution": "regional",
        "suspicion_level": "moderate_suspicion"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "4B - Moderate Suspicion for Malignancy" },
          { "key": "Finding Description", "includes": "coarse_heterogeneous" }
        ]
      }
    },
    {
      "id": "high-suspicion-spiculated-mass",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "irregular", "mass_margin": "spiculated", "mass_density": "high",
        "suspicion_level": "high_suspicion"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "4C - High Suspicion for Malignancy" },
          { "key": "Clinical Notes", "includes": "Spiculated margins" }
        ]
      }
    },
    {
      "id": "probably-benign-selection-warns-on-suspicious-mass-descriptors",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "mass", "mass_shape": "irregular", "mass_margin": "spiculated", "mass_density": "high",
        "suspicion_level": "probably_benign"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "3 - Probably Benign" },
          { "key": "Decision Check", "includes": "discordant" },
          { "key": "Decision Check", "includes": "Reassess" }
        ]
      }
    },
    {
      "id": "highly-suggestive-linear-calcifications",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "calcifications", "calc_morphology": "fine_linear", "calc_distribution": "linear",
        "suspicion_level": "highly_suggestive"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "5 - Highly Suggestive of Malignancy" },
          { "key": "Clinical Notes", "includes": "Fine linear/branching" },
          { "key": "Clinical Notes", "includes": "ductal involvement" }
        ]
      }
    },
    {
      "id": "developing-asymmetry",
      "inputs": {
        "modality": "mammography", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "asymmetry", "asymmetry_type": "developing", "suspicion_level": "moderate_suspicion"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "4B - Moderate Suspicion for Malignancy" },
          { "key": "Clinical Notes", "includes": "Developing asymmetry" }
        ]
      }
    },
    {
      "id": "associated-features",
      "inputs": {
        "modality": "mri", "study_context": "diagnostic", "additional_needed": "no",
        "finding_type": "associated_features", "suspicion_level": "moderate_suspicion"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "BI-RADS Category", "equals": "4B - Moderate Suspicion for Malignancy" },
          { "key": "Finding Description", "includes": "skin/nipple changes" }
        ]
      }
    }
  ]
}
