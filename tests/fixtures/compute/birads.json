        "noError": true,
        "fields": [
          { "key": "Assessment", "equals": "4C — High suspicion" },
          {
            "key": "Likelihood context",
            "equals": "50% to <95% expected likelihood of malignancy"
          },
          { "key": "U.S. reporting requirement", "includes": "within seven calendar days of interpretation" },
          { "key": "U.S. self-referred patient pathway", "includes": "must maintain a referral system" },
          { "key": "Published interval note", "includes": "overlaps at exactly 2% and exactly 50%" }
        ]
      }
    },
    {
      "id": "category-5",
      "inputs": { "assessment": "5" },
      "expect": {
        "noError": true,
        "fields": [
          {
            "key": "Assessment",
            "equals": "5 — Highly suggestive of malignancy"
          },
          {
            "key": "MQSA category",
            "equals": "Highly Suggestive of Malignancy"
          },
          {
            "key": "Likelihood context",
            "equals": "≥95% expected likelihood of malignancy"
          },
          { "key": "Next step", "includes": "Prompt tissue confirmation" },
          { "key": "U.S. reporting requirement", "includes": "within seven calendar days of interpretation" },
          { "key": "U.S. self-referred patient pathway", "includes": "must maintain a referral system" }
        ]
      }
    },
    {
      "id": "category-6",
      "inputs": { "assessment": "6" },
      "expect": {
        "noError": true,
        "fields": [
