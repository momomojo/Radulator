          { "key": "MQSA category", "equals": "Suspicious" },
          {
            "key": "Likelihood context",
            "equals": "2% but <95% expected likelihood of malignancy"
          },
          { "key": "Next step", "includes": "Tissue sampling is generally indicated" },
          { "key": "U.S. reporting requirement", "includes": "patient lay summary to the patient" },
