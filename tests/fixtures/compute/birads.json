        "noError": true,
        "fields": [
          { "key": "Assessment", "equals": "3 — Probably benign" },
          {
            "key": "Likelihood context",
            "equals": ">0% but ≤2% expected likelihood of malignancy"
          },
          { "key": "Next step", "includes": "initial 6-month follow-up" },
          { "key": "Published interval note", "includes": "overlaps at exactly 2% and exactly 50%" },
          { "key": "U.S. self-referred patient pathway", "includes": "patients who do not have a health care provider" }
        ]
      }
    },
    {
      "id": "category-4",
      "inputs": { "assessment": "4" },
