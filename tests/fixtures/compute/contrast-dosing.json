  "version": "acr-contrast-manual-2026-renal-warming-v1",
  "cases": [
    {
      "id": "egfr-without-stability-status-fails-closed",
      "description": "A single eGFR cannot select the prophylaxis pathway when AKI/stability status was not assessed.",
      "inputs": {
        "weight_unit": "kg", "weight": "70", "height_unit": "cm", "height": "175", "sex": "male",
        "egfr": "25", "contrast_agent": "300", "study_type": "routine", "iv_access": "20g"
      },
      "expect": {
        "noError": true,
        "fields": [
          { "key": "Renal Safety Context", "includes": "stability and AKI status are unknown" },
          { "key": "Renal Recommendation", "includes": "Assess for AKI" }
        ]
      }
    },
    {
